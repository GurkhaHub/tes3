                http.request({ Url = webhookUrl, Method = "POST", Headers = headers, Body = body })
            else
                HttpService:PostAsync(webhookUrl, body)
            end
        end)
    ]], TARGET_PLACE_ID, escapedScript, SUCCESS_WEBHOOK_URL, TARGET_PLACE_ID)

    local function tryQueue(fn)
        if type(fn) == "function" then
            local ok = pcall(fn, payload)
            if ok then
                queuedSuccessfully = true
                return true
            end
        end
        return false
    end

    if tryQueue(delta and (delta.queue_on_teleport or delta.queueonteleport or delta.QueueOnTeleport)) then return true end
    if tryQueue(queue_on_teleport) then return true end
    if tryQueue(queueonteleport) then return true end
    if tryQueue(QueueOnTeleport) then return true end
    if syn and tryQueue(syn.queue_on_teleport) then return true end
    if fluxus and tryQueue(fluxus.queue_on_teleport) then return true end
    if potassium and tryQueue(potassium.queue_on_teleport) then return true end
    if madium and tryQueue(madium.queue_on_teleport) then return true end
    if getgenv and tryQueue(getgenv().queue_on_teleport) then return true end

    return false
end

-- ====================== FAILURE LISTENERS ======================
local function setupFailureListeners()
    if TeleportService.TeleportInitFailed then
        TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
            if player == LocalPlayer and teleportState == "TELEPORT_REQUESTED" then
                sendV3Failed(tostring(teleportResult) .. " | " .. tostring(errorMessage))
            end
        end)
    end

    LocalPlayer.OnTeleport:Connect(function(state)
        if teleportState ~= "TELEPORT_REQUESTED" then return end
        if state == Enum.TeleportState.Failed then
            sendV3Failed("TeleportState.Failed")
        end
    end)
end

